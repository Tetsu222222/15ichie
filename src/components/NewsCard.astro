---
import { excerpt, formatDate, isNew, type News } from '../lib';

interface Props {
  entry: News;
}
const { entry } = Astro.props;
const { title, date } = entry.data;
---

<a href={`/news/${entry.id}/`} class="news-card card">
  <p class="news-card__meta">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {isNew(date) && <span class="badge">NEW</span>}
  </p>
  <h3>{title}</h3>
  <p class="news-card__excerpt">{excerpt(entry)}</p>
  <span class="news-card__more">続きを読む →</span>
</a>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    padding: 26px 26px 24px;
    text-decoration: none;
    color: inherit;
    height: 100%;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: var(--berry-200);
    color: inherit;
  }
  .news-card__meta {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }
  .badge {
    background: var(--berry-500);
    color: #fff;
    font-size: 0.66rem;
    padding: 1px 9px;
    border-radius: 999px;
    letter-spacing: 0.1em;
  }
  h3 {
    font-size: 1.08rem;
    margin-bottom: 0.5em;
  }
  .news-card__excerpt {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.8;
    flex: 1;
  }
  .news-card__more {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--berry-600);
  }
</style>
