---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import secretSea from '../assets/photos/secret-sea.jpg';
import secretMountain from '../assets/photos/secret-mountain.jpg';
import coolGrow from '../assets/photos/cool-grow.jpg';
import harvest from '../assets/photos/harvest.jpg';
import hero from '../assets/photos/hero.jpg';

const sections = [
  {
    no: '01',
    en: 'Sea Amino Acids',
    title: '海のアミノ酸で、旨みを注ぐ',
    img: secretSea,
    body: [
      'おいしいものをつくるには、その植物にあった栄養素を、実の部分にどれだけ注ぎ込めるかにあります。栄養の考え方は農家それぞれですが、',
      '当農園ではこの栄養に、海のアミノ酸として、アサリ・ハマグリ・カツオ・海藻などを発酵させた抽出液を多く使うことによって、旨みの部分を注ぎ込みます。',
    ],
  },
  {
    no: '02',
    en: 'Mountain Amino Acids',
    title: '山のアミノ酸で、丈夫な苗を',
    img: secretMountain,
    body: [
      'おいしいイチゴは丈夫な苗からできます。山のアミノ酸として、タケノコ・竹酢液などを発酵させた抽出液をたくさん使うことによって、健全で害虫に強い苗を育て、減農薬を行っています。',
      'これらのアミノ酸による酵素反応で、イチゴに甘みとフレッシュな食感を与えています。',
    ],
  },
  {
    no: '03',
    en: 'Little and Often',
    title: '1日2〜3回、こまめに届ける',
    img: hero,
    body: [
      '通常は月に1〜2度ほど、水と一緒にまとめて肥料を混ぜて流すことが多いのですが、',
      '当農園では1日2〜3回と細かく、海と山の栄養を含めた数種類の栄養を、季節によりブレンドして注ぎ込んでいます。',
    ],
  },
  {
    no: '04',
    en: 'Slow Ripening',
    title: '低温で、ゆっくり熟させる',
    img: coolGrow,
    body: [
      '本来は春の作物であるイチゴが冬に成長するためには、ビニールハウスで保温する必要があります。その保温温度の細かい設定は農家それぞれです。',
      'なるべく高温で日照に当てて育てたほうがイチゴは早く大きくなりますが、当農園では対照的に低温で育てることで、実が熟すのに時間がかかり、そのぶんゆっくりと栄養が実に注がれて、おいしいイチゴができます。',
    ],
  },
  {
    no: '05',
    en: 'Morning Harvest',
    title: '完熟・朝摘みを、その日のうちに',
    img: harvest,
    body: [
      'イチゴのおいしさは、なんといっても完熟した甘いイチゴを朝の寒い時間に収穫し、なるべく早い時間に食べるのが一番です！',
      '当農園では、完熟・朝摘みをその日のうちに出荷して、おいしくて新鮮なイチゴをお届けいたします。',
    ],
  },
];
---

<Base title="おいしさの秘密" description="海と山のアミノ酸・酵素栽培、低温でじっくり、完熟・朝摘み。いちごいちえの苺がおいしい理由。">
  <PageHero title="おいしさの秘密" eyebrow="Our Secret" image={secretSea} />

  <section class="section intro">
    <div class="container container--narrow reveal">
      <p class="intro__quote">人間に良いものは、<br />イチゴにも良い。</p>
      <p class="lead">
        人間も、納豆や漬物など発酵した食材は体にいいと言われています。<br />
        いちごいちえでは、この考えのもとでアミノ酸・酵素栽培を行っています。
      </p>
    </div>
  </section>

  <div class="steps">
    {
      sections.map((s, i) => (
        <section class:list={['step', { 'step--rev': i % 2 === 1 }]}>
          <div class="container step__grid">
            <div class="step__img reveal">
              <Image src={s.img} alt="" widths={[600, 1000, 1400]} sizes="(max-width: 860px) 100vw, 55vw" />
            </div>
            <div class="step__text reveal">
              <p class="step__no">
                <span>{s.no}</span>
                {s.en}
              </p>
              <h2>{s.title}</h2>
              {s.body.map((b) => <p>{b}</p>)}
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <section class="section section--sand">
    <div class="container container--narrow center reveal">
      <h2>その日の朝のおいしさを、<br />どうぞ味わってください。</h2>
      <div class="actions">
        <a href="/products/" class="btn btn--primary">商品・価格を見る <span class="arrow">→</span></a>
        <a href="/order/" class="btn btn--ghost">ご注文方法</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    text-align: center;
    padding-bottom: 32px;
  }
  .intro__quote {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(1.7rem, 4.4vw, 2.8rem);
    line-height: 1.6;
    letter-spacing: 0.1em;
    color: var(--berry-600);
    margin-bottom: 0.8em;
  }
  .step {
    padding-block: clamp(40px, 6vw, 72px);
  }
  .step__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .step--rev .step__img {
    order: 2;
  }
  .step__img :global(img) {
    border-radius: var(--radius);
    aspect-ratio: 3 / 2;
    object-fit: cover;
    width: 100%;
  }
  .step__no {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--leaf-500);
    margin-bottom: 12px;
  }
  .step__no span {
    font-family: var(--font-serif);
    font-size: 2.6rem;
    color: var(--berry-500);
    letter-spacing: 0;
    line-height: 1;
  }
  .step__text p:not(.step__no) {
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .step__grid {
      grid-template-columns: 1fr;
    }
    .step--rev .step__img {
      order: 0;
    }
  }
  .center {
    text-align: center;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 28px;
  }
</style>
