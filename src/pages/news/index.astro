---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getNews } from '../../lib';
import flower from '../../assets/photos/flower.jpg';

const news = await getNews();
---

<Base title="お知らせ" description="営業日・販売価格・販売開始など、いちごいちえからのお知らせです。">
  <PageHero title="お知らせ" eyebrow="News" image={flower} />
  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {news.map((n) => <div class="reveal"><NewsCard entry={n} /></div>)}
      </div>
      {news.length === 0 && <p>現在お知らせはありません。</p>}
    </div>
  </section>
</Base>
