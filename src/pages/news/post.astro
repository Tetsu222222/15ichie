---
// Googleフォームで投稿されたお知らせの個別ページ（/news/post/?id=…）。中身はブラウザで読み込む。
import Base from '../../layouts/Base.astro';
---

<Base title="お知らせ" description="いちごいちえからのお知らせです。">
  <article class="section article">
    <div class="container container--narrow">
      <a href="/news/" class="back">← お知らせ一覧</a>
      <div data-post>
        <p class="loading">読み込み中…</p>
      </div>
    </div>
  </article>
</Base>

<script>
  import { fetchFormNews, formatDate, bodyHtml, esc } from '../../scripts/form-news';

  const root = document.querySelector<HTMLElement>('[data-post]')!;
  const id = new URLSearchParams(location.search).get('id');
  const items = await fetchFormNews();
  const n = items.find((x) => x.id === id);
  if (!n) {
    root.innerHTML = '<p>お知らせが見つかりませんでした。削除されたか、URLが間違っている可能性があります。</p>';
  } else {
    document.title = document.title.replace(/^お知らせ/, n.title);
    root.innerHTML = `<header class="article__head">
        <time datetime="${esc(n.date)}">${formatDate(n.date)}</time>
        <h1>${esc(n.title)}</h1>
      </header>
      <div class="prose">${bodyHtml(n.body)}</div>`;
  }
</script>

<style is:global>
  .article {
    padding-top: clamp(40px, 6vw, 72px);
  }
  .article .back {
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    margin-bottom: 28px;
  }
  .article__head {
    padding-bottom: 24px;
    margin-bottom: 32px;
    border-bottom: 2px solid var(--berry-100);
  }
  .article__head time {
    display: block;
    color: var(--muted);
    font-weight: 700;
    letter-spacing: 0.1em;
    font-size: 0.88rem;
    margin-bottom: 6px;
  }
  .article__head h1 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    margin: 0;
  }
  .article .loading {
    color: var(--muted);
  }
</style>
