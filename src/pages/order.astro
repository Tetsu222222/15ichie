---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE, PRODUCTS } from '../site';
import { yen } from '../lib';
import basket from '../assets/photos/basket.jpg';

const tel = SITE.tel.replaceAll('-', '');
---

<Base title="ご注文・ご予約" description="お電話・メール・ご来店・注文フォームでご注文を承ります。ギフトはご予約制です。全国発送可。">
  <PageHero title="ご注文・ご予約" eyebrow="Order" image={basket} />

  <section class="section">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <p class="eyebrow">How to Order</p>
        <h2>ご注文方法</h2>
        <p class="lead">ご来店・お電話・メール・下記フォームで承ります。<br />季節や天候などによってお断りする場合がございますので、ご了承ください。</p>
      </div>
      <div class="ways">
        <a href={`tel:${tel}`} class="way card reveal">
          <span class="way__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
          </span>
          <h3>お電話</h3>
          <p class="way__main">{SITE.tel}</p>
          <p class="note">石黒携帯　FAX {SITE.fax}</p>
        </a>
        <a href={`mailto:${SITE.email}`} class="way card reveal">
          <span class="way__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          </span>
          <h3>メール</h3>
          <p class="way__main way__main--sm">{SITE.email}</p>
          <p class="note">ご注文内容・お届け先をお書きください</p>
        </a>
        <a href="/access/" class="way card reveal">
          <span class="way__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <h3>ご来店</h3>
          <p class="way__main way__main--sm">{SITE.hours}</p>
          <p class="note">{SITE.closed}定休・宅配も承ります</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--white" id="form">
    <div class="container container--narrow">
      <div class="section-head reveal">
        <p class="eyebrow">Order Form</p>
        <h2>ご注文フォーム</h2>
        <p>
          住所・お名前はお間違いのないようにお願いいたします。<br />
          <strong>当園からの返信をもってご注文完了</strong>とさせていただきます。3営業日以上たっても連絡がない場合は、恐れ入りますが再度ご連絡ください。
        </p>
      </div>

      <form class="form reveal" id="order-form" method="post" action="/api/contact" novalidate>
        <label>
          <span>お名前 <em>必須</em></span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <div class="row">
          <label>
            <span>郵便番号</span>
            <input type="text" name="zip" inputmode="numeric" autocomplete="postal-code" placeholder="321-0000" />
          </label>
          <label class="grow">
            <span>電話番号 <em>必須</em></span>
            <input type="tel" name="tel" required autocomplete="tel" />
          </label>
        </div>
        <label>
          <span>ご住所（都道府県から）</span>
          <input type="text" name="address" autocomplete="street-address" />
        </label>
        <label>
          <span>メールアドレス</span>
          <input type="email" name="email" autocomplete="email" />
        </label>
        <label>
          <span>ご注文内容 <em>必須</em></span>
          <textarea name="order" rows="7" required placeholder={'例）\nデラックス 2パック（1箱）\nお届け希望日：12月20日\nお届け先：（ご注文者と異なる場合）\nのし：お歳暮'}></textarea>
        </label>
        <!-- スパム対策の隠し欄（人には見えません。入力しないでください） -->
        <div class="hp" aria-hidden="true">
          <label>ウェブサイト<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button type="submit" class="btn btn--primary">送信する</button>
        <p class="form__error" role="alert" hidden></p>
        <p class="form__done" role="status" hidden>送信しました。当園からの返信をお待ちください。</p>
      </form>

      <details class="prices reveal">
        <summary>価格一覧（税込）を見る</summary>
        <table>
          <tbody>
            {
              PRODUCTS.map((p) => (
                <tr>
                  <th>{p.name}</th>
                  <td>
                    {'unit' in p ? `${p.unit} ` : ''}
                    {yen(p.price)}円{'from' in p && p.from ? '〜' : ''}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="note">時期により価格が変わります。最新は<a href="/news/">お知らせ</a>をご確認ください。宅配料金は関東エリア1,050円〜。</p>
      </details>
    </div>
  </section>

  <section class="section" id="payment">
    <div class="container container--narrow reveal">
      <p class="eyebrow">Payment</p>
      <h2>お支払い・発送について</h2>
      <p>
        ご来店・お電話・メールでもご注文を承っております。こちらからの返信、お振込み確認の上で発送となりますので、ご了承ください。
      </p>
      <div class="bank card">
        <h3>お振込み先</h3>
        <ul>
          {SITE.bank.map((b) => <li>{b}</li>)}
        </ul>
        <p class="note">※振込手数料はお客様のご負担とさせていただきます。</p>
      </div>
      <div class="point">
        <h3>ポイントカード</h3>
        <p>いつもお買い上げいただく皆様へのサービス向上のため、ポイントカードを発行しております。</p>
        <ul>
          <li>苺200円お買い上げにつき1ポイント（キャッシュレス決済の方は300円につき1ポイント）</li>
          <li>ポイントがたまると特典あり</li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  // ご注文フォーム：/api/contact（Cloudflare Worker）に送り、結果を画面に表示する
  const form = document.getElementById('order-form') as HTMLFormElement | null;
  const errorBox = form?.querySelector<HTMLElement>('.form__error');
  const doneBox = form?.querySelector<HTMLElement>('.form__done');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const TEL = '080-1131-5479';

  const showError = (msg: string) => {
    if (!errorBox) return;
    errorBox.textContent = msg;
    errorBox.hidden = false;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!errorBox || !doneBox || !button) return;
    errorBox.hidden = true;
    doneBox.hidden = true;
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));

    // ブラウザの必須チェック
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    button.disabled = true;
    button.textContent = '送信中…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const data = (await res.json().catch(() => ({}))) as {
        ok?: boolean;
        error?: string;
        fields?: Record<string, string>;
      };
      if (res.ok && data.ok) {
        form.reset();
        doneBox.hidden = false;
        doneBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      const fieldMsgs = Object.entries(data.fields ?? {}).map(([name, msg]) => {
        form.querySelector(`[name="${name}"]`)?.setAttribute('aria-invalid', 'true');
        return msg;
      });
      showError([data.error ?? '送信できませんでした。', ...fieldMsgs].join('\n'));
    } catch {
      showError(`送信できませんでした。通信環境をご確認のうえ再度お試しいただくか、お電話（${TEL}）でご連絡ください。`);
    } finally {
      button.disabled = false;
      button.textContent = '送信する';
    }
  });
</script>

<style>
  .ways {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .way {
    padding: 32px 24px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .way:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    color: inherit;
  }
  .way__icon {
    display: inline-grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--berry-50);
    color: var(--berry-600);
    margin-bottom: 12px;
  }
  .way h3 {
    font-size: 1rem;
    margin-bottom: 0.2em;
  }
  .way__main {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--berry-600);
    margin-bottom: 0.2em;
    word-break: break-all;
  }
  .way__main--sm {
    font-size: 1.1rem;
  }
  .way .note {
    margin: 0;
  }
  @media (max-width: 760px) {
    .ways {
      grid-template-columns: 1fr;
    }
  }
  .form {
    display: grid;
    gap: 20px;
    background: var(--cream);
    border-radius: var(--radius);
    padding: clamp(24px, 4vw, 40px);
  }
  .form label {
    display: grid;
    gap: 6px;
  }
  .form label > span {
    font-weight: 700;
    font-size: 0.92rem;
  }
  .form em {
    font-style: normal;
    font-size: 0.7rem;
    background: var(--berry-500);
    color: #fff;
    padding: 1px 8px;
    border-radius: 999px;
    margin-left: 6px;
    vertical-align: 2px;
  }
  .form input,
  .form textarea {
    width: 100%;
    font: inherit;
    font-size: 16px;
    padding: 0.8em 1em;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--ink);
    transition: border-color 0.2s;
  }
  .form input:focus,
  .form textarea:focus {
    outline: none;
    border-color: var(--berry-500);
  }
  .row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 20px;
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
  .form .btn {
    justify-self: center;
    min-width: 240px;
    font-size: 1.05rem;
  }
  .form__error {
    white-space: pre-line;
    background: var(--berry-50);
    border: 1px solid var(--berry-200);
    color: var(--berry-700);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    margin: 0;
    font-weight: 700;
  }
  .form [aria-invalid='true'] {
    border-color: var(--berry-500);
  }
  .form .btn:disabled {
    opacity: 0.6;
    cursor: wait;
    transform: none;
  }
  /* スパム対策の隠し欄：画面外に出して見えなくする */
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form {
    position: relative;
  }
  .form__done {
    text-align: center;
    font-weight: 700;
    color: var(--leaf-700);
    margin: 0;
  }
  .prices {
    margin-top: 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 4px 20px;
  }
  .prices summary {
    cursor: pointer;
    font-weight: 700;
    padding: 12px 0;
  }
  .prices table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 12px;
  }
  .prices th,
  .prices td {
    padding: 10px 4px;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .prices td {
    text-align: right;
    font-weight: 700;
  }
  .bank {
    padding: 24px 28px;
    margin-block: 28px;
  }
  .bank ul,
  .point ul {
    padding-left: 1.2em;
    margin: 0 0 0.6em;
  }
  .bank li,
  .point li {
    margin-bottom: 0.3em;
  }
  .bank li::marker,
  .point li::marker {
    color: var(--berry-500);
  }
  .point p {
    color: var(--muted);
  }
</style>
